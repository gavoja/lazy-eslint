{
  "name": "lazy-eslint",
  "version": "0.3.0",
  "description": "npm",
  "keywords": [
    "ESLint"
  ],
  "homepage": "https://github.com/gavoja/lazy-eslint#readme",
  "bugs": {
    "url": "https://github.com/gavoja/lazy-eslint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavoja/lazy-eslint.git"
  },
  "license": "MIT",
  "author": "Michal Kochel",
  "type": "module",
  "main": "./main.js",
  "exports": {
    ".": "./main.js"
  },
  "scripts": {
    "release": "dotenv run release-it -- --verbose",
    "lint": "npx eslint .",
    "format": "npx eslint . --fix"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@humanwhocodes/gitignore-to-minimatch": "^1.0.2",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.3"
    }
  },
  "peerDependencies": {
    "eslint": "^10.13.0"
  },
  "devDependencies": {
    "dotenv": "^18.0.8",
    "dotenv-cli": "^11.0.0",
    "release-it": "^21.1.1"
  }
}
